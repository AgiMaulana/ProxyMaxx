    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.0965"
        android:scaleY="0.0965"
        android:translateX="4.6"
        android:translateY="4.6">
