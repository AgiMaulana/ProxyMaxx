# Build output
dist/
build/
*.app

# Companion artifacts staged into Resources/ by Scripts/bundle-app.sh. They are rebuilt
# on every bundle, so a tracked copy could only ever drift. Vendored inputs such as
# Resources/android/Magisk/ stay tracked: they are not ours to rebuild.
Resources/proxymaxx-cli
Resources/proxymaxx-cli.new
Resources/browser/proxymaxx-extension/
Resources/android/proxymaxx-vpn.apk

# Android / Gradle
Android/**/build/
Android/**/.gradle/
Android/**/.kotlin/
Android/**/captures/
Android/**/.cxx/
Android/**/.externalNativeBuild/
Android/**/local.properties
.idea/
*.iml

# Android signing
*.jks
*.keystore
keystore.properties

