"android.emulator.advancedMode" = "Advanced Mode";
"android.emulator.playAVDs" = "Google Play AVDs";
"android.emulator.magiskToggle" = "Support Google Play AVDs with Magisk";
"android.emulator.magiskIntro" = "For a Google Play AVD, keep Magisk support enabled and read the following before consenting; ProxyMaxx does not silently root an emulator.";
"android.emulator.magiskConsent" = "Enabling this lets the setup patch a **temporary copy** of the AVD's ramdisk with bundled Magisk 30.7 (GPLv3), cold-start that AVD, and authorize **only** Android's ADB Shell UID (2000) from a one-shot boot service. The installed SDK image and the AVD configuration are left untouched, and the whole thing is undone by Revert. Root may affect Play Integrity, CTS and Google apps, so do not sign in with personal accounts in a rooted emulator.";
"android.emulator.revert" = "Revert";
