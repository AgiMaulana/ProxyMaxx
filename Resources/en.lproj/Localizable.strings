/* MARK: Android physical-device guide */
"android.device.title" = "Android Setup Guide";
"android.device.intro" = "Capture a physical Android device's traffic by pointing it at this Mac over the local network and trusting the ProxyMaxx certificate on it. Two things are needed: the proxy setting, and trust.";
"android.device.step1" = "1. Point the device at this Mac";
"android.device.step1Hint" = "The device must be on the same Wi-Fi network, and reachable at:";
"android.device.lanPlaceholder" = "<this Mac's LAN address>";
"android.device.step1Instructions" = "Set it in the device's Wi-Fi settings → Modify network → Advanced → Proxy → Manual. Use the address above for the hostname and port.";
"android.device.noLAN" = "No LAN address was detected. Connect this Mac to Wi-Fi, or use the Android emulator guide instead.";
"android.device.step2" = "2. Trust the certificate";
"android.device.step2Body" = "Export the CA and install it on the device. **Apps only see a certificate that is in the system store**, so also check the app's own network-security configuration: since Android 7 an app ignores user-installed CAs unless it opts in.";
"android.device.rootNote" = "Installing into the system store requires a rooted device or a modified boot image. For an emulator, use the Android Emulator guide, which does all of this automatically.";
"android.device.summary" = "Capture Android device traffic by configuring Wi-Fi proxy settings and handling user or system trust depending on the Android version.";

